<Window x:Class="EnglishManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:EnglishManager.Converters"
        mc:Ignorable="d"
        Title="English Manager - Quản Lý Từ Vựng &amp; Dữ Liệu Học Tập"
        Height="820" Width="1360"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        FontFamily="Roboto, Segoe UI"
        Background="#F4F5F9"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:WordClassToStringConverter x:Key="WordClassConv" />
        <conv:ContextTagToStringConverter x:Key="ContextTagConv" />
        <conv:CEFRLevelToStringConverter x:Key="CEFRLevelConv" />
        <conv:ListStringToStringConverter x:Key="ListStringConv" />
        <conv:DialogTypeToColorConverter x:Key="DialogColorConv" />
        <conv:DialogTypeToIconConverter x:Key="DialogIconConv" />
        <conv:InverseBooleanConverter x:Key="InverseBoolConverter" />

        <!-- Converters bổ sung cho Tab AI Dictionary -->
        <conv:InverseBooleanConverter x:Key="InverseBoolConv" />
        <conv:CountToVisibilityConverter x:Key="CountToVisConv" />
        <conv:ModeBackgroundConverter x:Key="ModeBgConverter" />

        <!-- Styles -->
        <Style x:Key="SidebarTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D2B4A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════════
             1. BỐ CỤC CHÍNH CỦA ỨNG DỤNG (SIDEBAR + MAIN CONTENT)
             ═══════════════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── A. SIDEBAR NAVIGATION ── -->
            <Border Grid.Column="0" Background="#1C1B29">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Brand / Header -->
                    <StackPanel Grid.Row="0" Margin="20,24,20,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:Card Width="40" Height="40" Background="#6750A4" UniformCornerRadius="10">
                                <materialDesign:PackIcon Kind="BookAlphabet" Width="24" Height="24" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </materialDesign:Card>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="EnglishManager" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="Quản Trị Từ Điển &amp; Dữ Liệu" Foreground="#9E9EB8" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <Separator Margin="0,16,0,0" Background="#2E2C44" />
                    </StackPanel>

                    <!-- Navigation Items -->
                    <StackPanel Grid.Row="1" Margin="10,8">
                        <!-- Tab 0: Từ Vựng (Vocabulary) -->
                        <Button Command="{Binding SelectVocabulariesTabCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                                            <Setter Property="Background" Value="#6750A4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="FormatLetterCase" Width="20" Height="20" Foreground="#D0BCFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Từ Vựng (Vocabulary)" Foreground="#FFFFFF" FontWeight="Medium" FontSize="13.5" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#36344E" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalVocabularies}" Foreground="#EADDFF" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Tab 1: Ngữ Nghĩa (Meaning) -->
                        <Button Command="{Binding SelectMeaningsTabCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                                            <Setter Property="Background" Value="#6750A4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="TagOutline" Width="20" Height="20" Foreground="#D0BCFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Ngữ Nghĩa (Meaning)" Foreground="#FFFFFF" FontWeight="Medium" FontSize="13.5" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#36344E" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalMeanings}" Foreground="#EADDFF" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Tab 2: Câu Ví Dụ (Example) -->
                        <Button Command="{Binding SelectExamplesTabCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="2">
                                            <Setter Property="Background" Value="#6750A4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CommentQuoteOutline" Width="20" Height="20" Foreground="#D0BCFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="Câu Ví Dụ (Example)" Foreground="#FFFFFF" FontWeight="Medium" FontSize="13.5" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#36344E" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalExamples}" Foreground="#EADDFF" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Tab 3: AI Dictionary (Tra cứu / Sinh từ qua AI) -->
                        <Button Command="{Binding SelectAiDictionaryTabCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarTabButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTabIndex}" Value="3">
                                            <Setter Property="Background" Value="#6750A4" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="RobotOutline" Width="20" Height="20"
                                                         Foreground="#D0BCFF" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="AI Dictionary" Foreground="#FFFFFF"
                                           FontWeight="Medium" FontSize="13.5" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar Footer: SQLite Database File Info -->
                    <Border Grid.Row="2" Background="#141320" Padding="14,14" Margin="10,0,10,12" CornerRadius="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Foreground="#80CBC4" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Cơ Sở Dữ Liệu SQLite" Foreground="#B0B0C8" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding DatabaseFileName}" Foreground="#E0E0FF" FontWeight="Bold" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Mở tệp..."
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="6"
                                        FontSize="11" Height="28" Padding="6,0" Margin="0,0,4,0"
                                        Foreground="#D0BCFF" BorderBrush="#4A4458"
                                        Command="{Binding SelectDatabaseFileCommand}" />
                                <Button Grid.Column="1" Content="Tạo mới"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="6"
                                        FontSize="11" Height="28" Padding="6,0" Margin="4,0,0,0"
                                        Foreground="#D0BCFF" BorderBrush="#4A4458"
                                        Command="{Binding CreateDatabaseFileCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── B. CONTENT AREA (TABCONTROL 3 TABS) ── -->
            <Grid Grid.Column="1" Margin="24,20,24,24">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                            BorderThickness="0" Background="Transparent" Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- ═══════════════════════════════════════════════════════════
                         TAB 0: QUẢN LÝ TỪ VỰNG (VOCABULARY)
                         ═══════════════════════════════════════════════════════════ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header & Filter Bar -->
                            <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="18,14" UniformCornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Danh Sách Từ Vựng" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" />
                                        <TextBlock Text="Quản lý từ vựng gốc, phát âm và cấp độ CEFR" FontSize="12" Foreground="#79747E" />
                                    </StackPanel>

                                    <!-- Filters: Search + CEFR Level -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Width="260"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Tìm kiếm theo từ, phiên âm..."
                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                                 Text="{Binding VocabVM.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,12,0" />

                                        <ComboBox Width="180"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Cấp độ CEFR"
                                                  ItemsSource="{Binding VocabVM.AvailableLevels}"
                                                  SelectedItem="{Binding VocabVM.FilterLevel}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource CEFRLevelConv}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Content="Đặt lại"
                                                Command="{Binding VocabVM.ResetFilterCommand}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                Background="#6750A4"
                                                Command="{Binding VocabVM.OpenCreateFormCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Thêm Từ Mới" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding VocabVM.LoadDataCommand}"
                                                ToolTip="Làm mới danh sách"
                                                Margin="8,0,0,0">
                                            <materialDesign:PackIcon Kind="Refresh" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- DataGrid Danh sách từ vựng -->
                            <materialDesign:Card Grid.Row="1" UniformCornerRadius="12">
                                <DataGrid ItemsSource="{Binding VocabVM.FilteredVocabularies}"
                                          SelectedItem="{Binding VocabVM.SelectedVocabulary}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="White"
                                          RowHeight="46"
                                          materialDesign:DataGridAssist.CellPadding="14 8 14 8">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Từ Vựng" Width="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding WordText}" FontWeight="Bold" FontSize="14" Foreground="#1C1B1F" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Cấp Độ" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <materialDesign:Chip Content="{Binding Level}"
                                                                         Background="#EADDFF" Foreground="#21005D"
                                                                         FontWeight="Bold" FontSize="11" Height="24" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Phát Âm (UK)" Binding="{Binding Phonetic_UK}" Width="130" />
                                        <DataGridTextColumn Header="Phát Âm (US)" Binding="{Binding Phonetic_US}" Width="130" />

                                        <DataGridTemplateColumn Header="Mô Tả Chung" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="#49454F" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Họ Hàng Từ (Word Family)" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding WordFamily, Converter={StaticResource ListStringConv}}"
                                                               Foreground="#49454F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Thao Tác" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                ToolTip="Chỉnh sửa từ vựng"
                                                                Command="{Binding DataContext.VocabVM.StartEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="PencilOutline" Foreground="#6750A4" Width="18" Height="18" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                ToolTip="Xóa từ vựng"
                                                                Command="{Binding DataContext.VocabVM.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#B3261E" Width="18" Height="18" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════
                         TAB 1: QUẢN LÝ NGỮ NGHĨA (VOCABULARY MEANING)
                         ═══════════════════════════════════════════════════════════ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header & Filter Bar -->
                            <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="18,14" UniformCornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Danh Sách Ngữ Nghĩa" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" />
                                        <TextBlock Text="Định nghĩa theo từ loại, ngữ cảnh, từ đồng nghĩa và trái nghĩa" FontSize="12" Foreground="#79747E" />
                                    </StackPanel>

                                    <!-- Filters: ComboBox Từ Vựng Cha + Từ Loại + Search -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- ComboBox Lọc Từ Vựng Cha -->
                                        <ComboBox Width="200"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Lọc theo từ vựng"
                                                  ItemsSource="{Binding MeaningVM.Vocabularies}"
                                                  SelectedValuePath="Id"
                                                  DisplayMemberPath="WordText"
                                                  SelectedValue="{Binding MeaningVM.FilterVocabularyId}"
                                                  Margin="0,0,12,0" />

                                        <ComboBox Width="160"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Từ loại"
                                                  ItemsSource="{Binding MeaningVM.AvailableWordClasses}"
                                                  SelectedItem="{Binding MeaningVM.FilterWordClass}"
                                                  Margin="0,0,12,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource WordClassConv}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBox Width="200"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Tìm định nghĩa, đồng nghĩa..."
                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                                 Text="{Binding MeaningVM.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Content="Đặt lại"
                                                Command="{Binding MeaningVM.ResetFilterCommand}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                Background="#6750A4"
                                                Command="{Binding MeaningVM.OpenCreateFormCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Thêm Nghĩa Mới" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding MeaningVM.LoadDataCommand}"
                                                ToolTip="Làm mới danh sách"
                                                Margin="8,0,0,0">
                                            <materialDesign:PackIcon Kind="Refresh" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- DataGrid Danh sách ngữ nghĩa -->
                            <materialDesign:Card Grid.Row="1" UniformCornerRadius="12">
                                <DataGrid ItemsSource="{Binding MeaningVM.FilteredMeanings}"
                                          SelectedItem="{Binding MeaningVM.SelectedMeaning}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="White"
                                          RowHeight="48"
                                          materialDesign:DataGridAssist.CellPadding="14 8 14 8">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Từ Loại" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <materialDesign:Chip Content="{Binding WordClass, Converter={StaticResource WordClassConv}}"
                                                                         Background="#E8DEF8" Foreground="#1D192B"
                                                                         FontWeight="SemiBold" Height="24" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Định Nghĩa Tiếng Việt" Binding="{Binding Definition_VI}" Width="240" />
                                        <DataGridTextColumn Header="Định Nghĩa Tiếng Anh" Binding="{Binding Definition_EN}" Width="260" />

                                        <DataGridTemplateColumn Header="Ngữ Cảnh" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <materialDesign:Chip Content="{Binding Context, Converter={StaticResource ContextTagConv}}"
                                                                         Background="#E0F2F1" Foreground="#004D40" Height="24" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Đồng Nghĩa" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Synonyms, Converter={StaticResource ListStringConv}}"
                                                               Foreground="#2E7D32" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Trái Nghĩa" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Antonyms, Converter={StaticResource ListStringConv}}"
                                                               Foreground="#C62828" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Thao Tác" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                ToolTip="Chỉnh sửa ngữ nghĩa"
                                                                Command="{Binding DataContext.MeaningVM.StartEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="PencilOutline" Foreground="#6750A4" Width="18" Height="18" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                ToolTip="Xóa ngữ nghĩa"
                                                                Command="{Binding DataContext.MeaningVM.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#B3261E" Width="18" Height="18" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════
                         TAB 2: QUẢN LÝ CÂU VÍ DỤ (MEANING EXAMPLE)
                         ═══════════════════════════════════════════════════════════ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header & Filter Bar -->
                            <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="18,14" UniformCornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                        <TextBlock Text="Danh Sách Câu Ví Dụ" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" />
                                        <TextBlock Text="Câu ví dụ thực tế minh họa gắn với từng ngữ nghĩa cụ thể" FontSize="12" Foreground="#79747E" />
                                    </StackPanel>

                                    <!-- Filters: ComboBox Ngữ Nghĩa Cha + Search -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- ComboBox Lọc Ngữ Nghĩa Cha -->
                                        <ComboBox Width="300"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  materialDesign:HintAssist.Hint="Lọc theo ngữ nghĩa"
                                                  ItemsSource="{Binding ExampleVM.Meanings}"
                                                  SelectedValuePath="MeaningId"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectedValue="{Binding ExampleVM.FilterMeaningId}"
                                                  Margin="0,0,12,0" />

                                        <TextBox Width="220"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Tìm câu ví dụ..."
                                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                                 Text="{Binding ExampleVM.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Content="Đặt lại"
                                                Command="{Binding ExampleVM.ResetFilterCommand}"
                                                Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                Background="#6750A4"
                                                Command="{Binding ExampleVM.OpenCreateFormCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Thêm Ví Dụ Mới" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding ExampleVM.LoadDataCommand}"
                                                ToolTip="Làm mới danh sách"
                                                Margin="8,0,0,0">
                                            <materialDesign:PackIcon Kind="Refresh" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- DataGrid Danh sách câu ví dụ -->
                            <materialDesign:Card Grid.Row="1" UniformCornerRadius="12">
                                <DataGrid ItemsSource="{Binding ExampleVM.FilteredExamples}"
                                          SelectedItem="{Binding ExampleVM.SelectedExample}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="White"
                                          RowHeight="50"
                                          materialDesign:DataGridAssist.CellPadding="14 8 14 8">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Câu Tiếng Anh" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Sentence_EN}" FontStyle="Italic" FontWeight="Medium" Foreground="#1C1B1F" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Dịch Tiếng Việt" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Sentence_VI}" Foreground="#49454F" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Từ Mục Tiêu (Highlight)" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <materialDesign:Chip Content="{Binding HighlightedTarget}"
                                                                         Background="#FFF8E1" Foreground="#F57F17"
                                                                         FontWeight="Bold" Height="24" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Thao Tác" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                ToolTip="Chỉnh sửa câu ví dụ"
                                                                Command="{Binding DataContext.ExampleVM.StartEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="PencilOutline" Foreground="#6750A4" Width="18" Height="18" />
                                                        </Button>
                                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                                Width="32" Height="32"
                                                                ToolTip="Xóa câu ví dụ"
                                                                Command="{Binding DataContext.ExampleVM.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#B3261E" Width="18" Height="18" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>
                        </Grid>
                    </TabItem>

                    <!-- ═══════════════════════════════════════════════════════════
                         TAB 3: AI DICTIONARY (SINH TỪ THEO LEVEL / TRA CỨU TỪ)
                         ═══════════════════════════════════════════════════════════ -->
                    <TabItem>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- ── Header Card: Tiêu đề + Mode Toggle ── -->
                            <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" Padding="18,14" UniformCornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="RobotOutline" Width="24" Height="24"
                                                                     Foreground="#6750A4" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="AI Dictionary" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Sinh từ ngẫu nhiên hoặc tra cứu từ vựng tiếng Anh thông qua AI Agent"
                                                   FontSize="12" Foreground="#79747E" Margin="34,2,0,0" />
                                    </StackPanel>

                                    <!-- Mode Toggle Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button materialDesign:ButtonAssist.CornerRadius="8"
                                                Foreground="White"
                                                Background="{Binding AiDictVM.IsGenerateMode, Converter={StaticResource ModeBgConverter}}"
                                                Command="{Binding AiDictVM.SwitchToGenerateCommand}"
                                                Height="36" Padding="16,0" Margin="0,0,8,0"
                                                Style="{StaticResource MaterialDesignRaisedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DiceMultipleOutline" Width="18" Height="18"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Sinh từ theo Level" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button materialDesign:ButtonAssist.CornerRadius="8"
                                                Foreground="{Binding AiDictVM.IsLookupMode, Converter={StaticResource ModeBgConverter}}"
                                                BorderBrush="{Binding AiDictVM.IsLookupMode, Converter={StaticResource ModeBgConverter}}"
                                                Background="White"
                                                Command="{Binding AiDictVM.SwitchToLookupCommand}"
                                                Height="36" Padding="16,0"
                                                Style="{StaticResource MaterialDesignOutlinedButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock Text="Tra cứu từ vựng" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>

                            <!-- ── Content: Left Panel + Right Preview ── -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ───────────────────────────────────────
                                     LEFT: Control Panel (Sinh từ / Tra cứu)
                                     ─────────────────────────────────────── -->
                                <materialDesign:Card Grid.Column="0" UniformCornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Cấu hình truy vấn" FontSize="15" FontWeight="Bold"
                                                   Foreground="#1C1B1F" Margin="0,0,0,20" />

                                        <!-- GENERATE MODE -->
                                        <StackPanel Visibility="{Binding AiDictVM.IsGenerateMode, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Chọn cấp độ CEFR:" FontSize="12"
                                                       Foreground="#79747E" Margin="0,0,0,8" />
                                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      materialDesign:HintAssist.Hint="Cấp độ từ vựng"
                                                      ItemsSource="{Binding AiDictVM.AvailableLevels}"
                                                      SelectedItem="{Binding AiDictVM.SelectedLevel}"
                                                      FontSize="14" FontWeight="SemiBold"
                                                      Margin="0,0,0,20" />
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="10"
                                                    Background="#6750A4"
                                                    HorizontalAlignment="Stretch"
                                                    Height="44"
                                                    Command="{Binding AiDictVM.GenerateCommand}"
                                                    IsEnabled="{Binding AiDictVM.IsLoading, Converter={StaticResource InverseBoolConv}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20"
                                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Sinh Từ Ngẫu Nhiên" FontWeight="Bold"
                                                               FontSize="13.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- LOOKUP MODE -->
                                        <StackPanel Visibility="{Binding AiDictVM.IsLookupMode, Converter={StaticResource BoolToVisConverter}}">
                                            <TextBlock Text="Nhập từ tiếng Anh cần tra:" FontSize="12"
                                                       Foreground="#79747E" Margin="0,0,0,8" />
                                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     materialDesign:HintAssist.Hint="Ví dụ: sustainable, resilient..."
                                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                                     Text="{Binding AiDictVM.LookupWord, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="14" FontWeight="SemiBold"
                                                     Margin="0,0,0,20" />
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="10"
                                                    Background="#6750A4"
                                                    HorizontalAlignment="Stretch"
                                                    Height="44"
                                                    Command="{Binding AiDictVM.LookupCommand}"
                                                    IsEnabled="{Binding AiDictVM.IsLoading, Converter={StaticResource InverseBoolConv}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Translate" Width="20" Height="20"
                                                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Tra Cứu Từ Vựng" FontWeight="Bold"
                                                               FontSize="13.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Loading Progress Bar -->
                                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                                                     Style="{StaticResource MaterialDesignLinearProgressBar}"
                                                     Visibility="{Binding AiDictVM.IsLoading, Converter={StaticResource BoolToVisConverter}}" />

                                        <!-- Status Message -->
                                        <Border Background="#F3EDF7" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AiDictVM.StatusMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AiDictVM.StatusMessage}"
                                                       FontSize="12" TextWrapping="Wrap" Foreground="#49454F" />
                                        </Border>

                                        <!-- Separator + Save Button (hiện khi có kết quả) -->
                                        <Separator Margin="0,20"
                                                   Visibility="{Binding AiDictVM.HasResult, Converter={StaticResource BoolToVisConverter}}" />
                                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="10"
                                                Background="#2E7D32"
                                                HorizontalAlignment="Stretch"
                                                Height="44"
                                                Command="{Binding AiDictVM.SaveToDatabaseCommand}"
                                                IsEnabled="{Binding AiDictVM.IsLoading, Converter={StaticResource InverseBoolConv}}"
                                                Visibility="{Binding AiDictVM.HasResult, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="Lưu vào từ điển cá nhân" FontWeight="Bold"
                                                           FontSize="13" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </materialDesign:Card>

                                <!-- ───────────────────────────────────────
                                     RIGHT: Result Preview Panel
                                     ─────────────────────────────────────── -->
                                <materialDesign:Card Grid.Column="2" UniformCornerRadius="12" >
                                    <Grid>
                                        <!-- Trạng thái rỗng chưa có kết quả -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                    Visibility="{Binding AiDictVM.HasResult, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AiDictVM.HasResult}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />

                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <materialDesign:PackIcon Kind="RobotHappyOutline" Width="64" Height="64"
                                                                     Foreground="#D0BCFF" HorizontalAlignment="Center"
                                                                     Margin="0,0,0,16" />
                                            <TextBlock Text="Chưa có kết quả" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="#9E9CB0" HorizontalAlignment="Center" />
                                            <TextBlock Text="Chọn cấp độ và nhấn 'Sinh Từ', hoặc nhập từ và nhấn 'Tra Cứu'"
                                                       FontSize="12.5" Foreground="#AEACC0" HorizontalAlignment="Center"
                                                       TextAlignment="Center" Margin="40,6,40,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Kết quả xem trước -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24" 
                                                      Visibility="{Binding AiDictVM.HasResult, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Margin="15">

                                                <!-- ── WORD HEADER ── -->
                                                <Border Background="#F3EDF7" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding AiDictVM.CurrentResult.WordText}"
                                                                       FontSize="28" FontWeight="Bold" Foreground="#1C1B1F" />
                                                            <TextBlock Text="{Binding AiDictVM.CurrentResult.Description}"
                                                                       FontSize="12.5" Foreground="#49454F"
                                                                       TextWrapping="Wrap" Margin="0,4,0,10" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding AiDictVM.CurrentResult.Phonetic_UK, StringFormat='🇬🇧 {0}'}"
                                                                           FontSize="13" Foreground="#6750A4"
                                                                           FontStyle="Italic" Margin="0,0,20,0" />
                                                                <TextBlock Text="{Binding AiDictVM.CurrentResult.Phonetic_US, StringFormat='🇺🇸 {0}'}"
                                                                           FontSize="13" Foreground="#6750A4" FontStyle="Italic" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <materialDesign:Chip Grid.Column="1"
                                                                             Content="{Binding AiDictVM.CurrentResult.Level}"
                                                                             Background="#EADDFF" Foreground="#21005D"
                                                                             FontWeight="Bold" FontSize="14"
                                                                             Height="32" VerticalAlignment="Top" />
                                                    </Grid>
                                                </Border>

                                                <!-- ── WORD FAMILY ── -->
                                                <Border Background="#E8F5E9" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                                        Visibility="{Binding AiDictVM.CurrentResult.WordFamily.Count, Converter={StaticResource CountToVisConv}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="FamilyTree" Width="16" Height="16"
                                                                                 Foreground="#2E7D32" VerticalAlignment="Center"
                                                                                 Margin="0,0,6,0" />
                                                        <TextBlock Text="Họ hàng từ: " Foreground="#2E7D32"
                                                                   FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AiDictVM.CurrentResult.WordFamily, Converter={StaticResource ListStringConv}}"
                                                                   Foreground="#2E7D32" FontSize="12"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- ── MEANINGS LIST ── -->
                                                <ItemsControl ItemsSource="{Binding AiDictVM.CurrentResult.Meanings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" CornerRadius="10" Padding="16"
                                                                    Margin="0,0,0,12"
                                                                    BorderBrush="#E8DEF8" BorderThickness="1">
                                                                <StackPanel>
                                                                    <!-- WordClass + Context chips -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                        <materialDesign:Chip Content="{Binding WordClass}"
                                                                                             Background="#E8DEF8" Foreground="#1D192B"
                                                                                             FontWeight="Bold" Height="26"
                                                                                             Margin="0,0,8,0" />
                                                                        <materialDesign:Chip Content="{Binding Context}"
                                                                                             Background="#E0F2F1" Foreground="#004D40"
                                                                                             FontSize="11" Height="24" />
                                                                    </StackPanel>

                                                                    <!-- Definition VI (nổi bật) -->
                                                                    <TextBlock Text="{Binding Definition_VI}"
                                                                               FontSize="14" FontWeight="SemiBold"
                                                                               Foreground="#1C1B1F"
                                                                               TextWrapping="Wrap" Margin="0,0,0,4" />

                                                                    <!-- Definition EN (in nghiêng) -->
                                                                    <TextBlock Text="{Binding Definition_EN}"
                                                                               FontSize="12.5" Foreground="#49454F"
                                                                               FontStyle="Italic"
                                                                               TextWrapping="Wrap" Margin="0,0,0,10" />

                                                                    <!-- Synonyms / Antonyms -->
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" FlowDirection="LeftToRight">
                                                                        <TextBlock Text="≈ " Foreground="#2E7D32" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Synonyms, Converter={StaticResource ListStringConv}}"
                                                                                   Foreground="#2E7D32" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        <TextBlock Text="    ≠ " Foreground="#C62828" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Antonyms, Converter={StaticResource ListStringConv}}"
                                                                                   Foreground="#C62828" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                    </StackPanel>

                                                                    <!-- Examples -->
                                                                    <ItemsControl ItemsSource="{Binding Examples}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="#F8F5FF" CornerRadius="6"
                                                                                        Padding="12,8" Margin="0,0,0,6"
                                                                                        BorderBrush="#EDE7F6" BorderThickness="1">
                                                                                    <StackPanel>
                                                                                        <TextBlock Text="{Binding Sentence_EN}"
                                                                                                   FontSize="13" FontStyle="Italic"
                                                                                                   Foreground="#1C1B1F"
                                                                                                   TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Sentence_VI}"
                                                                                                   FontSize="12"
                                                                                                   Foreground="#79747E"
                                                                                                   TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                                        <Border Background="#EADDFF" CornerRadius="4"
                                                                                                Padding="6,2" Margin="0,5,0,0"
                                                                                                HorizontalAlignment="Left">
                                                                                            <TextBlock Text="{Binding HighlightedTarget}"
                                                                                                       FontSize="11" FontWeight="Bold"
                                                                                                       Foreground="#4A148C" />
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </materialDesign:Card>

                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             2. IN-APP MODAL FORM: THÊM / SỬA TỪ VỰNG (VOCABULARY)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Background="#80000000"
                Visibility="{Binding VocabVM.IsFormOpen, Converter={StaticResource BoolToVisConverter}}">
            <materialDesign:Card Width="560" MaxHeight="680" UniformCornerRadius="16" Padding="28,24"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="{Binding VocabVM.FormTitle}" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" />
                        <TextBlock Text="Điền đầy đủ thông tin từ vựng gốc và các phiên âm" FontSize="12" Foreground="#79747E" Margin="0,2,0,0" />
                        <Separator Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
                        <StackPanel Margin="0,10,8,0">
                            <!-- WordText -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Từ tiếng Anh (WordText) *"
                                     Text="{Binding VocabVM.FormWordText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" FontWeight="SemiBold"
                                     Margin="0,0,0,16" />

                            <!-- Description (Mô tả ý nghĩa chung) -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Mô tả ý nghĩa chung của từ vựng"
                                     Text="{Binding VocabVM.FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="70"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,16" />

                            <!-- Level -->
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Cấp độ CEFR *"
                                      ItemsSource="{Binding VocabVM.AvailableLevels}"
                                      SelectedItem="{Binding VocabVM.FormLevel}"
                                      Margin="0,0,0,16">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource CEFRLevelConv}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Phonetics UK & US -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Phiên âm UK (IPA)"
                                         Text="{Binding VocabVM.FormPhoneticUK, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Phiên âm US (IPA)"
                                         Text="{Binding VocabVM.FormPhoneticUS, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!-- Audio Paths -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Đường dẫn Audio UK"
                                         Text="{Binding VocabVM.FormAudioPathUK, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Đường dẫn Audio US"
                                         Text="{Binding VocabVM.FormAudioPathUS, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <!-- Word Family -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Họ hàng từ (cách nhau bởi dấu phẩy, ví dụ: act, actor, action)"
                                     Text="{Binding VocabVM.FormWordFamilyText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Hủy"
                                Command="{Binding VocabVM.CloseFormCommand}"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#6750A4"
                                Content="Lưu Dữ Liệu"
                                Command="{Binding VocabVM.SaveFormCommand}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             3. IN-APP MODAL FORM: THÊM / SỬA NGỮ NGHĨA (VOCABULARY MEANING)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Background="#80000000"
                Visibility="{Binding MeaningVM.IsFormOpen, Converter={StaticResource BoolToVisConverter}}">
            <materialDesign:Card Width="600" MaxHeight="720" UniformCornerRadius="16" Padding="28,24"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="{Binding MeaningVM.FormTitle}" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" />
                        <TextBlock Text="Chọn từ vựng cha và cấu hình định nghĩa ngữ nghĩa" FontSize="12" Foreground="#79747E" Margin="0,2,0,0" />
                        <Separator Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
                        <StackPanel Margin="0,0,8,0">
                            <!-- COMBOBOX CHỌN TỪ VỰNG CHA (LIÊN KẾT BẢNG) -->
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Thuộc Từ Vựng Cha (Vocabulary) *"
                                      ItemsSource="{Binding MeaningVM.Vocabularies}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="WordText"
                                      SelectedValue="{Binding MeaningVM.FormVocabularyId}"
                                      FontSize="14" FontWeight="SemiBold"
                                      Margin="0,0,0,16" />

                            <!-- WordClass & ContextTag -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Từ loại *"
                                          ItemsSource="{Binding MeaningVM.AvailableWordClasses}"
                                          SelectedItem="{Binding MeaningVM.FormWordClass}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource WordClassConv}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Ngữ cảnh *"
                                          ItemsSource="{Binding MeaningVM.AvailableContextTags}"
                                          SelectedItem="{Binding MeaningVM.FormContext}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ContextTagConv}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- Definition VI -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Định nghĩa Tiếng Việt *"
                                     Text="{Binding MeaningVM.FormDefinitionVI, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                                     Margin="0,0,0,16" />

                            <!-- Definition EN -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Định nghĩa Tiếng Anh (Definition_EN) *"
                                     Text="{Binding MeaningVM.FormDefinitionEN, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                                     Margin="0,0,0,16" />

                            <!-- Synonyms & Antonyms -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Từ đồng nghĩa (phân cách bằng dấu phẩy)"
                                     Text="{Binding MeaningVM.FormSynonymsText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16" />

                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Từ trái nghĩa (phân cách bằng dấu phẩy)"
                                     Text="{Binding MeaningVM.FormAntonymsText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Hủy"
                                Command="{Binding MeaningVM.CloseFormCommand}"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#6750A4"
                                Content="Lưu Dữ Liệu"
                                Command="{Binding MeaningVM.SaveFormCommand}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             4. IN-APP MODAL FORM: THÊM / SỬA CÂU VÍ DỤ (MEANING EXAMPLE)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Background="#80000000"
                Visibility="{Binding ExampleVM.IsFormOpen, Converter={StaticResource BoolToVisConverter}}">
            <materialDesign:Card Width="600" MaxHeight="680" UniformCornerRadius="16" Padding="28,24"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock Text="{Binding ExampleVM.FormTitle}" FontSize="20" FontWeight="Bold" Foreground="#1C1B1F" />
                        <TextBlock Text="Chọn ngữ nghĩa cha và nhập câu ví dụ minh họa song ngữ" FontSize="12" Foreground="#79747E" Margin="0,2,0,0" />
                        <Separator Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Form Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18">
                        <StackPanel Margin="0,0,8,0">
                            <!-- COMBOBOX CHỌN NGỮ NGHĨA CHA (LIÊN KẾT BẢNG) -->
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Thuộc Ngữ Nghĩa Cha (Meaning) *"
                                      ItemsSource="{Binding ExampleVM.Meanings}"
                                      SelectedValuePath="MeaningId"
                                      DisplayMemberPath="DisplayText"
                                      SelectedValue="{Binding ExampleVM.FormMeaningId}"
                                      FontSize="13.5"
                                      Margin="0,0,0,16" />

                            <!-- Sentence EN -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Câu ví dụ Tiếng Anh (Sentence_EN) *"
                                     Text="{Binding ExampleVM.FormSentenceEN, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="75"
                                     FontStyle="Italic"
                                     Margin="0,0,0,16" />

                            <!-- Sentence VI -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Dịch nghĩa Tiếng Việt (Sentence_VI) *"
                                     Text="{Binding ExampleVM.FormSentenceVI, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="75"
                                     Margin="0,0,0,16" />

                            <!-- Highlighted Target -->
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Từ mục tiêu trong câu (HighlightedTarget)"
                                     Text="{Binding ExampleVM.FormHighlightedTarget, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Hủy"
                                Command="{Binding ExampleVM.CloseFormCommand}"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#6750A4"
                                Content="Lưu Dữ Liệu"
                                Command="{Binding ExampleVM.SaveFormCommand}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             5. IN-APP DIALOG SERVICE MODAL OVERLAY (Thông báo / Xác nhận xóa)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Background="#90000000"
                Visibility="{Binding DialogService.IsOpen, Converter={StaticResource BoolToVisConverter}}">
            <materialDesign:Card Width="460" UniformCornerRadius="16" Padding="28,24"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="20"
                                Background="{Binding DialogService.Type, Converter={StaticResource DialogColorConv}}"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding DialogService.Type, Converter={StaticResource DialogIconConv}}"
                                       Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding DialogService.Title}" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="#1C1B1F" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding DialogService.Message}"
                               FontSize="13.5" LineHeight="20" Foreground="#49454F" TextWrapping="Wrap" Margin="0,0,0,24" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Hủy bỏ"
                                Command="{Binding DialogService.CancelCommand}"
                                Visibility="{Binding DialogService.IsConfirmation, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Xác nhận"
                                Background="{Binding DialogService.Type, Converter={StaticResource DialogColorConv}}"
                                Command="{Binding DialogService.ConfirmCommand}" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Border>
    </Grid>
</Window>
