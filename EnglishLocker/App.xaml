<Application x:Class="EnglishLocker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnglishLocker.Converters"
             ShutdownMode="OnMainWindowClose">

    <!-- ═══════════════════════════════════════════════════════════════════
         StartupUri KHÔNG được set ở đây vì ta khởi tạo MainWindow
         thông qua DI container trong App.xaml.cs (OnStartup).
         ═══════════════════════════════════════════════════════════════════ -->

    <Application.Resources>
        <!-- ── Converters dùng chung toàn app ── -->
        <conv:CheatCountToVisibilityConverter x:Key="CheatVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:StringToSolidBrushConverter x:Key="StringToBrushConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>
        <conv:WordClassToStringConverter x:Key="WordClassToStrConverter"/>
        <conv:ContextTagToStringConverter x:Key="ContextTagToStrConverter"/>
        <conv:ObjectEqualityConverter x:Key="ObjectEqualityConverter"/>
    </Application.Resources>
</Application>
