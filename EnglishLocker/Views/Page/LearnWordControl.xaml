<UserControl x:Class="EnglishLocker.Views.LearnWordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:English.ViewModel.ViewModels;assembly=English.ViewModel"
             xmlns:views="clr-namespace:EnglishLocker.Views"
             xmlns:conv="clr-namespace:EnglishLocker.Converters"
             d:DataContext="{d:DesignInstance Type=vm:LearnWordViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FontFamily="Segoe UI">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <UserControl.Resources>
        <!-- Dynamic Selector cho Action Tab -->
        <conv:TabTemplateSelector x:Key="TabTemplateSelector"/>

        <!-- Fallback DataTemplate tường minh cho LearnWordActionViewModel -->
        <DataTemplate DataType="{x:Type vm:LearnWordActionViewModel}">
            <views:LearnWordActionControl/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Border Background="#1C1C30"
                CornerRadius="24"
                Padding="22"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="45" Opacity="0.4" ShadowDepth="6"/>
            </Border.Effect>

            <!-- Layout 2 cột: Information (60%) | Dynamic Action Tab (40%) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.0*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: INFORMATION PANEL (TAB VIEW) -->
                <views:LearnWordInformationControl Grid.Column="0"
                                                   DataContext="{Binding InformationViewModel}"
                                                   Margin="0,0,12,0"/>

                <!-- CỘT PHẢI: ACTION PANEL (DYNAMIC TAB VIEW ĐA NĂNG) -->
                <ContentControl Grid.Column="1"
                                Content="{Binding ActionViewModel}"
                                ContentTemplateSelector="{StaticResource TabTemplateSelector}"
                                Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
