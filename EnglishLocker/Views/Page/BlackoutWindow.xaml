<Window x:Class="EnglishLocker.Views.BlackoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EnglishLocker - Monitor Locked"
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black"
        Cursor="Arrow">

    <!-- ═══════════════════════════════════════════════════════════════════
         Màn hình đen (Blackout) cho các màn hình phụ (Multi-monitor)
         - Che kín toàn bộ màn hình phụ
         - Chặn Alt+F4 và thao tác tắt cửa sổ khi chưa hoàn thành câu hỏi
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Biểu tượng ổ khóa -->
            <TextBlock Text="🔒"
                       FontSize="72"
                       Foreground="#333344"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Tiêu đề thông báo -->
            <TextBlock Text="MÀN HÌNH NÀY ĐANG BỊ KHÓA"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#444455"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Hướng dẫn người dùng -->
            <TextBlock Text="Vui lòng hoàn thành câu hỏi tiếng Anh trên màn hình chính để mở khóa."
                       FontSize="16"
                       Foreground="#333344"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
