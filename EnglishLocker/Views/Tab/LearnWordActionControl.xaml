<UserControl x:Class="EnglishLocker.Views.LearnWordActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:English.ViewModel.ViewModels;assembly=English.ViewModel"
             xmlns:conv="clr-namespace:EnglishLocker.Converters"
             d:DataContext="{d:DesignInstance Type=vm:LearnWordActionViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="500"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Style nút Submit -->
        <Style x:Key="SubmitActionButton" TargetType="Button">
            <Setter Property="Background" Value="#6C63FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7E77FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#554CCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style ProgressBar tiến trình gõ -->
        <Style x:Key="AttemptProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#2D2D4D"/>
            <Setter Property="Foreground" Value="#6C63FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#23233C"
            CornerRadius="18"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Progress header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Tiến độ luyện gõ"
                               Foreground="#8E85FF"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="#FFFFFF"
                               FontSize="14"
                               FontWeight="Bold">
                        <Run Text="{Binding CurrentAttempt, Mode=OneWay}"/>
                        <Run Text=" / " Foreground="#8888AA"/>
                        <Run Text="{Binding TargetAttempts, Mode=OneWay}" Foreground="#8888AA"/>
                    </TextBlock>
                </Grid>
                <ProgressBar Style="{StaticResource AttemptProgressBarStyle}"
                             Minimum="0"
                             Maximum="{Binding TargetAttempts}"
                             Value="{Binding CurrentAttempt, Mode=OneWay}"/>
            </StackPanel>

            <!-- Khu vực gõ từ -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Margin="0,10,0,10">

                <!-- Từ mẫu cỡ lớn (ẩn/hiện qua IsWordVisible) -->
                <Border MinHeight="80" Margin="0,0,0,22" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WordText}"
                               Foreground="#FFFFFF"
                               FontSize="50"
                               FontWeight="Black"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsWordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                </Border>

                <!-- TextBox nhập liệu — bắt Enter → SubmitCommand -->
                <Border Background="#2B2B48"
                        BorderBrush="#6C63FF"
                        BorderThickness="2"
                        CornerRadius="14"
                        Padding="14,10"
                        Margin="0,0,0,10">
                    <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#00FFC2"
                             CaretBrush="#00FFC2"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="30"
                             FontWeight="Bold"
                             TextAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SubmitCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Border>

                <TextBlock Text="Gõ lại từ trên và nhấn Enter để xác nhận"
                           Foreground="#8888AA"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Feedback -->
                <Border Background="#1C1C30"
                        CornerRadius="10"
                        Padding="14,10">
                    <TextBlock Text="{Binding FeedbackMessage}"
                               Foreground="{Binding FeedbackColor}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <!-- Nút Xác nhận -->
            <Button Grid.Row="2"
                    Content="✓  Xác nhận (Enter)"
                    Style="{StaticResource SubmitActionButton}"
                    Command="{Binding SubmitCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0"/>
        </Grid>
    </Border>
</UserControl>
