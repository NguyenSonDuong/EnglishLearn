<UserControl x:Class="EnglishLocker.Views.LearnWordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:English.ViewModel.ViewModels;assembly=English.ViewModel"
             xmlns:conv="clr-namespace:EnglishLocker.Converters"
             d:DataContext="{d:DesignInstance Type=vm:LearnWordViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">

    <UserControl.Resources>
        <!-- Converter hiển thị ẩn/hiện từ mẫu theo cờ IsWordVisible -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- ── Style cho Button Xác nhận ── -->
        <Style x:Key="SubmitActionButton" TargetType="Button">
            <Setter Property="Background" Value="#6C63FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#7E77FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#554CCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Style cho ProgressBar tiến trình gõ ── -->
        <Style x:Key="AttemptProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="#2D2D4D"/>
            <Setter Property="Foreground" Value="#6C63FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Khung chính căn giữa màn hình với hiệu ứng đổ bóng -->
    <Grid Margin="24">
        <Border Background="#1C1C30"
                CornerRadius="24"
                Padding="28"
                MaxWidth="1080"
                MaxHeight="720"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="45" Opacity="0.4" ShadowDepth="6"/>
            </Border.Effect>

            <!-- Bố cục 2 cột phân tách rõ ràng (55% cho Information, 45% cho Practice) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.0*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════════════════════════
                     CỘT TRÁI: INFORMATION PANEL (THÔNG TIN TỪ VỰNG, NGHĨA & VÍ DỤ)
                     ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Column="0"
                        Background="#23233C"
                        CornerRadius="18"
                        Padding="32,28"
                        Margin="0,0,14,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Badge danh mục / Tiêu đề nhỏ -->
                            <Border Background="#302E5C"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,14">
                                <TextBlock Text="📖 TỪ VỰNG CẦN HỌC"
                                           Foreground="#8E85FF"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </Border>

                            <!-- Typography lớn cho WordText và Phonetic -->
                            <TextBlock Text="{Binding WordText}"
                                       Foreground="#FFFFFF"
                                       FontSize="40"
                                       FontWeight="ExtraBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4"/>

                            <TextBlock Text="{Binding Phonetic}"
                                       Foreground="#A5A5C7"
                                       FontSize="19"
                                       FontStyle="Italic"
                                       Margin="0,0,0,20"/>

                            <!-- Đường phân cách ngang nhẹ -->
                            <Border Height="1"
                                    Background="#363657"
                                    Margin="0,0,0,20"/>

                            <!-- Tiêu đề phần giải nghĩa -->
                            <TextBlock Text="Định nghĩa &amp; Ví dụ minh họa:"
                                       Foreground="#8E85FF"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <!-- ItemsControl danh sách các nghĩa (Meanings) -->
                            <ItemsControl ItemsSource="{Binding Meanings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2B2B48"
                                                CornerRadius="12"
                                                Padding="18,14"
                                                Margin="0,0,0,14">
                                            <StackPanel>
                                                <!-- Từ loại (WordClass badge) -->
                                                <Border Background="#3A386D"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding WordClass}"
                                                               Foreground="#00E5FF"
                                                               FontSize="12"
                                                               FontWeight="Bold"/>
                                                </Border>

                                                <!-- Nghĩa tiếng Việt -->
                                                <TextBlock Text="{Binding DefinitionVI}"
                                                           Foreground="#EEEEEE"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           LineHeight="22"
                                                           Margin="0,0,0,10"/>

                                                <!-- Nested ItemsControl: Danh sách ví dụ minh họa -->
                                                <ItemsControl ItemsSource="{Binding Examples}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="• "
                                                                           Foreground="#7A7A9E"
                                                                           FontSize="14"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding}"
                                                                           Foreground="#B8B8D4"
                                                                           FontSize="13.5"
                                                                           FontStyle="Italic"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="19"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ═══════════════════════════════════════════════════════════════
                     CỘT PHẢI: ACTION PANEL (KHU VỰC LUYỆN GÕ LẶP LẠI & TIẾN TRÌNH)
                     ═══════════════════════════════════════════════════════════════ -->
                <Border Grid.Column="1"
                        Background="#23233C"
                        CornerRadius="18"
                        Padding="32,28"
                        Margin="14,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Tiến trình gõ từ -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Tiến độ luyện gõ"
                                           Foreground="#8E85FF"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="#FFFFFF"
                                           FontSize="14"
                                           FontWeight="Bold">
                                    <Run Text="{Binding CurrentAttempt, Mode=OneWay}"/>
                                    <Run Text=" / " Foreground="#8888AA"/>
                                    <Run Text="{Binding TargetAttempts, Mode=OneWay}" Foreground="#8888AA"/>
                                </TextBlock>
                            </Grid>

                            <!-- Thanh tiến trình ProgressBar -->
                            <ProgressBar Style="{StaticResource AttemptProgressBarStyle}"
                                         Minimum="0"
                                         Maximum="{Binding TargetAttempts}"
                                         Value="{Binding CurrentAttempt, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Thân khu vực gõ: Hiển thị từ mẫu và TextBox nhập liệu -->
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="0,10,0,10">

                            <!-- Từ gốc kích thước rất lớn (có thể ẩn/hiện thông qua cờ IsWordVisible) -->
                            <Border MinHeight="80"
                                    Margin="0,0,0,24"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding WordText}"
                                           Foreground="#FFFFFF"
                                           FontSize="46"
                                           FontWeight="Black"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsWordVisible, Converter={StaticResource BoolToVisConverter}}"/>
                            </Border>

                            <!-- TextBox nhập liệu lớn, căn giữa, bắt phím Enter kích hoạt SubmitCommand -->
                            <Border Background="#2B2B48"
                                    BorderBrush="#6C63FF"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Padding="14,10">
                                <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                                         Foreground="#00FFC2"
                                         CaretBrush="#00FFC2"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="28"
                                         FontWeight="Bold"
                                         TextAlignment="Center">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding SubmitCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Border>

                            <TextBlock Text="Gõ lại từ trên và nhấn Enter để xác nhận"
                                       Foreground="#8888AA"
                                       FontSize="12.5"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,0"/>

                            <!-- Thông báo phản hồi trạng thái (FeedbackMessage) -->
                            <Border Background="#1C1C30"
                                    CornerRadius="10"
                                    Padding="14,10"
                                    Margin="0,20,0,0">
                                <TextBlock Text="{Binding FeedbackMessage}"
                                           Foreground="{Binding FeedbackColor}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- Footer: Nút xác nhận thủ công (dành cho chuột/cảm ứng) -->
                        <Button Grid.Row="2"
                                Content="✓  Xác nhận (Enter)"
                                Style="{StaticResource SubmitActionButton}"
                                Command="{Binding SubmitCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
