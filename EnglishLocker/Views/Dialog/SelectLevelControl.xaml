<UserControl x:Class="EnglishLocker.Views.SelectLevelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:English.ViewModel.ViewModels;assembly=English.ViewModel"
             xmlns:conv="clr-namespace:EnglishLocker.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=vm:SelectLevelViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="720"
             FontFamily="Segoe UI">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <conv:CEFRToSolidBrushConverter x:Key="CEFRToBrushConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConverter"/>

        <!-- Style cho Button chọn cấp độ -->
        <Style x:Key="LevelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="levelBorder"
                                Background="#2B2B48"
                                BorderBrush="#3D3D60"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="10,14">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Emoji}"
                                           FontSize="26"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="levelLabel"
                                           Text="{Binding DisplayName}"
                                           Foreground="#CCCCEE"
                                           FontSize="20"
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Description}"
                                           Foreground="#7777AA"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="88"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="levelBorder" Property="Background" Value="#252542"/>
                                <Setter TargetName="levelBorder" Property="BorderBrush"
                                        Value="{Binding Level, Converter={StaticResource StringToBrushConverter}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="levelBorder" Property="Background" Value="#1E1E38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút Confirm -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6C63FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#7E77FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#554CCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#404060"/>
                                <Setter Property="Foreground" Value="#666688"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style cho nút Cancel -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2B2B48"/>
            <Setter Property="Foreground" Value="#AAAACC"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#44446A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#363658"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Card Dialog nổi bật phủ overlay -->
    <Border Background="#1C1C30"
            CornerRadius="20"
            BorderBrush="#6C63FF"
            BorderThickness="1"
            MaxWidth="760"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="8" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="🎯" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chọn Cấp Độ Từ Vựng"
                                   Foreground="#FFFFFF"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Hệ thống sẽ tạo từ vựng phù hợp với trình độ của bạn"
                                   Foreground="#8888AA"
                                   FontSize="13"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Border Height="1" Background="#363657" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ── 6 ô cấp độ A1 → C2 ── -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding AvailableLevels}"
                          Margin="0,0,0,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Mỗi ô là Button gọi SelectLevelCommand, viền sáng khi IsSelected -->
                        <Grid>
                            <Button Style="{StaticResource LevelButtonStyle}"
                                    Command="{Binding DataContext.SelectLevelCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>

                            <!-- Viền highlight khi là SelectedLevel -->
                            <Border CornerRadius="14"
                                    BorderThickness="3"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding>
                                                        <MultiBinding.Converter>
                                                            <conv:ObjectEqualityConverter/>
                                                        </MultiBinding.Converter>
                                                        <Binding Path="DataContext.SelectedLevel"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderBrush"
                                                        Value="{Binding ColorHex, Converter={StaticResource StringToBrushConverter}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Cấp độ đang chọn (label preview) ── -->
            <Border Grid.Row="2"
                    Background="#23233C"
                    CornerRadius="10"
                    Padding="16,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding SelectedLevel, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="Đang chọn: "
                                   Foreground="#8888AA"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <Border CornerRadius="6"
                                Padding="10,3"
                                Margin="6,0,0,0"
                                Background="{Binding SelectedLevel.ColorHex, Converter={StaticResource StringToBrushConverter}}">
                            <TextBlock Text="{Binding SelectedLevel.DisplayName}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="ExtraBold"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedLevel.Description}"
                                   Foreground="#AAAACC"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Loading & Error -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="⏳ " FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Đang tạo từ vựng..."
                                   Foreground="#A5A5C7"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="#2D1A1A"
                            BorderBrush="#8B1A1A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="0,4,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FCA5A5"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Footer Buttons ── -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="✕  Hủy"
                        Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding CloseCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>

                <Button Grid.Column="2"
                        Content="✨  Tạo từ ngay"
                        Style="{StaticResource ConfirmButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
