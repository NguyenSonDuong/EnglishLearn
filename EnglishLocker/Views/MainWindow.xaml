<Window x:Class="EnglishLocker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:English.ViewModel.ViewModels;assembly=English.ViewModel"
        xmlns:views="clr-namespace:EnglishLocker.Views"
        xmlns:controls="clr-namespace:EnglishLocker.Controls"
        Title="EnglishLocker"
        
        WindowStyle="None"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        Topmost="True"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        
        Background="#1a1a2e">

    <!-- ═══════════════════════════════════════════════════════════════════
         Kiosk-mode: WindowStyle=None + Maximized + Topmost + NoResize
         → Toàn màn hình, không viền, luôn trên cùng, không thể resize.
         MainWindow đóng vai trò Single Page Application Container.
         ═══════════════════════════════════════════════════════════════════ -->

    <Window.Resources>
        <!-- ── DataTemplate mapping cho các Page UserControl ── -->
        <DataTemplate DataType="{x:Type vm:QuizViewModel}">
            <views:QuizControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LearnWordViewModel}">
            <views:LearnWordControl/>
        </DataTemplate>

        <!-- ── DataTemplate mapping cho Navigator dialogs & screens ── -->
        <DataTemplate DataType="{x:Type vm:StartupWarningViewModel}">
            <views:StartupWarningControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectLevelViewModel}">
            <views:SelectLevelControl/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════════════════════
             TẦNG 1: SINGLE PAGE HOST VỚI ANIMATION CHUYỂN TRANG MƯỢT MÀ
             Hiển thị Navigator.CurrentPage và kích hoạt hiệu ứng đóng/mở
             theo Navigator.TransitionDirection.
             ═══════════════════════════════════════════════════════════════════ -->
        <controls:PageTransitionControl PageContent="{Binding Navigator.CurrentPage}"
                                        TransitionDirection="{Binding Navigator.TransitionDirection}"/>

        <!-- ═══════════════════════════════════════════════════════════════════
             TẦNG 2: HỆ THỐNG ĐIỀU PHỐI DIALOG & MÀN HÌNH (INavigatorService)
             Toàn bộ thông báo, cảnh báo, màn hình overlay đều hiển thị trên MainWindow
             thông qua MainViewModel.Navigator.DialogStack (Z-Index cao nhất)
             ═══════════════════════════════════════════════════════════════════ -->
        <ItemsControl ItemsSource="{Binding Navigator.DialogStack}"
                      Panel.ZIndex="1000">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Modal Overlay phủ toàn màn hình với nền mờ tối và căn giữa dialog kèm hiệu ứng xuất hiện -->
                    <Grid Background="#D00A0A16">
                        <ContentControl Content="{Binding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                            <ContentControl.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1"
                                                             Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ContentControl.Triggers>
                        </ContentControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ── Nút đóng ứng dụng khẩn cấp ── -->
        <Button Content="X"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="40" Height="40"
                Margin="15,15,15,0"
                Panel.ZIndex="1001">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#AA000000"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="0,0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#5a52e0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#4a42c0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
