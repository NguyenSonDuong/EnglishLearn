<Window x:Class="EnglishLocker.Views.StartupWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:English.ViewModel.ViewModels;assembly=English.ViewModel"
        mc:Ignorable="d"
        Title="Cảnh Báo Chế Độ Khóa - EnglishLocker"
        Width="760" Height="570"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Style Button Đồng ý -->
        <Style x:Key="AcceptButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Button Từ chối -->
        <Style x:Key="RejectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#c8324b"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#a8253b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Thân Window chính bo góc nổi bật -->
    <Border Background="#1a1a2e"
            CornerRadius="18"
            BorderBrush="#F59E0B"
            BorderThickness="2"
            Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 1. Header cảnh báo ── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#3B2816" Margin="0,0,14,0">
                        <TextBlock Text="⚠️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="#F59E0B"
                                   FontSize="20"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   Foreground="#94A3B8"
                                   FontSize="13"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Separator Background="#334155" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ── 2. Nội dung chi tiết các cảnh báo ── -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Card 1: Khóa Kiosk Mode & Khởi động lại -->
                <Border Background="#22223a"
                        CornerRadius="12"
                        BorderBrush="#3a3a6a"
                        BorderThickness="1"
                        Padding="18,16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔒" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LockWarningText}"
                                   Foreground="#E2E8F0"
                                   FontSize="13.5"
                                   LineHeight="21"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- Card 2: Lời khuyên công việc & Tắt ứng dụng -->
                <Border Background="#2E1D24"
                        CornerRadius="12"
                        BorderBrush="#6B2D38"
                        BorderThickness="1"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="💡" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AdviceText}"
                                   Foreground="#FCA5A5"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   LineHeight="20"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── 3. Footer Action Buttons (Từ chối / Đồng ý) ── -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nút Từ chối & Thoát App -->
                <Button Grid.Column="0"
                        Content="✕ TỪ CHỐI &amp; TẮT ỨNG DỤNG"
                        Style="{StaticResource RejectButtonStyle}"
                        Command="{Binding RejectCommand}"
                        HorizontalAlignment="Left"
                        Width="270"/>

                <!-- Nút Đồng ý & Bắt đầu học -->
                <Button Grid.Column="1"
                        Content="✓ ĐỒNG Ý &amp; BẮT ĐẦU HỌC"
                        Style="{StaticResource AcceptButtonStyle}"
                        Command="{Binding AcceptCommand}"
                        HorizontalAlignment="Right"
                        Width="270"/>
            </Grid>
        </Grid>
    </Border>
</Window>
